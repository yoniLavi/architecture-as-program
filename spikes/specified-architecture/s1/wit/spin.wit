package aap:s1spike@0.1.0;

/// S1's test guest: work that scales with its argument and nothing else. It imports
/// no capability, so whatever stops it is the store's bound, never a grant.
world spin {
    /// Run `n` rounds of a mixing loop and return the result (so the loop is not
    /// optimised away). n = u64::MAX is the hostile case: it does not finish.
    export burn: func(n: u64) -> u64;
    /// Allocate and touch `mib` MiB of linear memory, returning the bytes touched.
    export hog: func(mib: u32) -> u64;
}
