dist/
refs/
.vscode/settings.json
__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/
# Rust build output for the sandbox tier. The compiled .wasm artifacts under
# poc/sandbox/wasm/ ARE committed (so tests run without a Rust toolchain); only
# the intermediate target/ tree is ignored.
poc/sandbox/rust/target/
.DS_Store
# The feed-triage service's runtime state, fetched feeds, run records and
# digests. Everything the service writes lands here and nowhere else.
var/*
!var/README

# Spike crates (explore-specified-architecture): built components are committed,
# the intermediate target/ trees are not.
spikes/**/target/
# S3's prover toolchain checkouts (Aeneas, Charon), built by s3/setup.sh.
spikes/specified-architecture/s3/vendor/
# Lean build output.
spikes/**/.lake/
