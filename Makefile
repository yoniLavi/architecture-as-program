ROOT := $(shell git rev-parse --show-toplevel)
DIST := $(ROOT)/dist
PY   := uv run python3
# The evaluation harness is the one build step that is not stdlib-only: it reports
# capability-boundary overhead and sandbox-tier results, both of which need
# wasmtime (the `poc` group). `uv run --group poc` installs it on demand, so this
# needs no separate setup step in CI.
PY_POC := uv run --group poc python3

# ── Shared research artifact ─────────────────────────────────────────
# graphs/*.json and diagrams/*.typ live at the repository root and back
# every *living* paper. Their rendered figures land in dist/graphs and
# dist/diagrams; living papers reference them root-absolutely (/dist/...).
GRAPHS_SRC := $(filter-out graphs/schema.json,$(wildcard graphs/*.json))
GRAPHS_TXT := $(patsubst graphs/%.json,$(DIST)/graphs/%.graph,$(GRAPHS_SRC))
GRAPHS_SVG := $(patsubst graphs/%.json,$(DIST)/graphs/%.svg,$(GRAPHS_SRC))

DIAGRAMS_SRC := $(wildcard diagrams/*.typ)
DIAGRAMS_SVG := $(patsubst diagrams/%.typ,$(DIST)/diagrams/%.svg,$(DIAGRAMS_SRC))

# ── Paper corpus ─────────────────────────────────────────────────────
# Documents live under papers/<id>/; outputs under dist/papers/<id>/.
#
# Paper 1 is frozen *and published* (papers/01-vision/PUBLISHED.json), so it
# is not built at all: the build serves the files stored under
# papers/01-vision/published/ — the Zenodo PDF byte-for-byte, plus web copies
# and figures rendered once and frozen — and check-freeze holds them to the
# checksums in the marker. Rebuilding it would route the published paper
# through shared inputs (filter, CSL, bibliography, typst and pandoc versions)
# that move with the living papers; it did, until September 2026. Its frozen
# sources stay in the tree as the provenance of the record, guarded as before.
P1_DIR := papers/01-vision
P1_OUT := $(DIST)/papers/01-vision
P1_STORE := $(P1_DIR)/published
P1_SERVED := $(patsubst $(P1_STORE)/%,$(P1_OUT)/%,$(shell find $(P1_STORE) -type f))
P1_DOCS := $(P1_OUT)/proposal.pdf $(P1_OUT)/proposal.md $(P1_OUT)/proposal.html

# Publication-named PDF alias. Convention: each paper's PDF is also emitted as
# a citable, self-identifying copy named lavi-<year>-<slug>.pdf — the file to
# upload to venues. Internal build names stay proposal.*. The year is finalised
# at publication (Paper 1: 2026, Zenodo, doi:10.5281/zenodo.21473361 — now
# served from papers/01-vision/published/ rather than built; Paper 2:
# provisional until published — rename if the year slips).

# Paper 2 (living) builds from the shared top-level artifact.
P2_DIR := papers/02-demonstrator
P2_OUT := $(DIST)/papers/02-demonstrator
P2_DOCS := $(P2_OUT)/proposal.pdf $(P2_OUT)/proposal.md $(P2_OUT)/proposal.html
P2_PUB_PDF := $(P2_OUT)/lavi-2026-confinement-by-construction.pdf

# There is no Paper 3. The method paper was merged into Paper 2 on 30 September
# 2026 (openspec change merge-and-condense-papers); its last text is at the tag
# paper-3-before-merge.

# Inspector figures: committed screenshots regenerated by the UI's e2e run
# (`make ui-e2e`), copied into dist/ for Paper 2 the same way the committed
# WASM artifacts serve the tests — the corpus build itself never needs Node.
#
# Which screenshots Paper 2 actually uses is *derived from the paper source*
# rather than listed here, on the same single-source principle as the graph
# figures: the paper references one of the five, and hardcoding that filename
# would either ship four unused images or silently break the HTML the day a
# second figure is added. Only the referenced ones are staged and copied.
UI_FIGS_USED := $(sort $(shell grep -oh '/dist/ui/[A-Za-z0-9_-]*\.png' $(P2_DIR)/proposal.typ | sed 's|/dist/ui/||'))
UI_FIGS := $(addprefix $(DIST)/ui/,$(UI_FIGS_USED))

# Deprecated compatibility aliases: dist/proposal.{pdf,md,html} are copies of
# Paper 2's outputs, kept for one transition so existing inbound links and the
# GitHub Pages deploy keep working. Remove once those links point at
# dist/papers/02-demonstrator/ (see README).
ALIASES := $(DIST)/proposal.pdf $(DIST)/proposal.md $(DIST)/proposal.html

.PHONY: build clean validate-graphs test wasm check-freeze check-hedges grammar evaluation evaluation-feed generation paper1 paper2 aliases api ui ui-check ui-e2e

build: validate-graphs check-freeze check-hedges grammar evaluation evaluation-feed generation paper1 paper2 aliases
	@echo "Build complete."

grammar: $(DIST)/grammar.md
evaluation: $(DIST)/evaluation.md $(DIST)/evaluation.json
evaluation-feed: $(DIST)/evaluation-feed.md
generation: $(DIST)/generation.md
paper1: $(P1_SERVED) $(P1_DOCS)
paper2: $(P2_DOCS) $(P2_PUB_PDF)
aliases: $(ALIASES)

# Grammar card — built from scripts/type_parser.py and the canonical
# graph JSONs so that the documented grammar and subtype rules cannot
# drift from the implementation without failing the build.
$(DIST)/grammar.md: scripts/emit-grammar.py scripts/type_parser.py $(GRAPHS_SRC) | $(DIST)
	$(PY) scripts/emit-grammar.py

# Evaluation artifact — the demonstrator's own evidence, run and consolidated:
# the graph-mutation corpus (each case pinned to an expected verdict *and* the
# reason class it must be caught by), the capability-boundary overhead against
# the stated envelope, and the prompt-injection outcome on both tiers. Emits both
# evaluation.md (for a reader) and evaluation.json (what Paper 2 typesets from).
# Generated like the grammar card so the paper's Evaluation section cannot drift
# from the code: a divergence from a pin fails the build rather than quietly
# rewriting the table.
POC_SRC  := $(wildcard poc/*.py) $(wildcard poc/sandbox/*.py)
POC_WASM := $(wildcard poc/sandbox/wasm/*.wasm)
$(DIST)/evaluation.md: $(POC_SRC) $(POC_WASM) $(GRAPHS_SRC) scripts/graph_validator.py scripts/type_parser.py | $(DIST)
	$(PY_POC) -m poc.evaluate

# One run, two serialisations: evaluation.md for a reader, evaluation.json for
# Paper 2's Evaluation section, which loads it with typst's `json()` so its
# tables are typeset from the run rather than transcribed from it. Both come out
# of the single recipe above (this make is 3.81 — no grouped `&:` targets), so
# this rule only has to establish the ordering and assert the file appeared.
$(DIST)/evaluation.json: $(DIST)/evaluation.md
	@test -f $@ || { echo "poc.evaluate did not write $@" >&2; exit 1; }

# Feed-triage evaluation artifact — the service's own evidence, pinned like the
# one above and written to its *own* files, so that nothing about the service can
# move a figure Paper 2 typesets from evaluation.json: a corpus of rewirings,
# each component held to its `with` clause, the tier table, and a hostile-feed
# corpus run through the whole service on both tiers. The hostile run serves its
# feeds from a server on 127.0.0.1 (stdlib, ephemeral port); nothing else is
# contacted and no model is called. Emits evaluation-feed.md and .json.
FEED_SRC := $(wildcard poc/feeds/*.py) $(wildcard poc/feeds/corpus/*)
$(DIST)/evaluation-feed.md: $(POC_SRC) $(POC_WASM) $(FEED_SRC) $(GRAPHS_SRC) scripts/graph_validator.py scripts/type_parser.py | $(DIST)
	$(PY_POC) -m poc.evaluate_feed

# Generation-experiment artifact — the node-generation experiment's results,
# rendered from the committed trial records (poc/generation/results.json, derived
# from poc/generation/runs/). Stdlib-only and offline: this step calls no model
# and builds no crate, so the build needs neither a subscription nor a Rust
# toolchain. Running trials is `python -m poc.generation.harness`, by hand. The
# one pin: the hand-written bodies must pass the same pipeline clean, or the
# report is refused.
$(DIST)/generation.md: poc/generation/report.py poc/generation/results.json | $(DIST)
	$(PY) -m poc.generation.report

# Validate the shared graph JSON files: structural, type-aware, cross-graph.
# Depends on `test` so validator-logic changes are tested before use.
# (Paper 1's pinned graphs are frozen historical inputs, guarded by check-freeze
# rather than re-validated against the current schema.)
validate-graphs: test $(GRAPHS_SRC) scripts/validate-graphs.py scripts/graph_validator.py scripts/type_parser.py graphs/schema.json
	@$(PY) scripts/validate-graphs.py

# Guard the frozen paper against silent edits: its sources must match the
# freeze commit. Skips (with a warning) only in a shallow checkout; in a full
# clone it fails if the freeze commit is missing or not an ancestor of HEAD.
check-freeze:
	@$(PY) scripts/check-freeze.py

# Guard the hedging of the living papers' unproven claims. Each pin quotes a
# claim and the qualification that bounds it *together*, so a rewrite cannot
# shed the hedge and keep the claim. A regression guard over the passages it
# pins, not a check that the corpus is hedged — see the script's docstring and
# the review obligation in AGENTS.md for what it does not cover.
check-hedges:
	@$(PY) scripts/check-hedges.py

# Run the test suite (type parser + graph validator + runtime) via pytest.
test:
	@uv run pytest

# ── Shared figure generation (backs living papers) ──────────────────
# Generate pseudocode and diagram source from canonical graph JSON.
$(DIST)/graphs/%.graph $(DIST)/graphs/%.typ: graphs/%.json scripts/generate-graph.py | $(DIST)/graphs
	$(PY) scripts/generate-graph.py $<

# Compile diagram Typst to SVG.
$(DIST)/graphs/%.svg: $(DIST)/graphs/%.typ
	typst compile $< $@ --format svg --root $(ROOT)

# Hand-written illustrative diagrams.
$(DIST)/diagrams/%.svg: diagrams/%.typ | $(DIST)/diagrams
	typst compile $< $@ --format svg --root $(ROOT)

# ── Paper 1 (frozen, published): served, never rebuilt ──────────────
# Copies only. No typst, pandoc, filter, CSL, or bibliography touches it.
$(P1_SERVED): $(P1_OUT)/%: $(P1_STORE)/%
	@mkdir -p $(@D)
	cp $< $@

# The internal name, kept so existing links resolve: the same published bytes.
$(P1_OUT)/proposal.pdf: $(P1_STORE)/lavi-2026-architecture-as-program.pdf | $(P1_OUT)
	cp $< $@

# ── Paper 2 (living): figures from the shared artifact ──────────────
$(DIST)/ui/%.png: ui/screenshots/%.png | $(DIST)/ui
	cp $< $@

$(P2_OUT)/proposal.pdf: $(P2_DIR)/proposal.typ citations.bib $(GRAPHS_TXT) $(GRAPHS_SVG) $(DIAGRAMS_SVG) $(DIST)/evaluation.json $(UI_FIGS) | $(P2_OUT)
	typst compile $(P2_DIR)/proposal.typ $@ --root $(ROOT) --pdf-standard a-2b

$(P2_PUB_PDF): $(P2_OUT)/proposal.pdf
	cp $< $@

$(P2_OUT)/proposal.md: $(P2_DIR)/proposal.typ citations.bib $(GRAPHS_TXT) $(GRAPHS_SVG) $(DIAGRAMS_SVG) $(DIST)/evaluation.json $(UI_FIGS) scripts/resolve-crossrefs.lua scripts/ieee.csl scripts/clean-markdown.py | $(P2_OUT)
	pandoc $(P2_DIR)/proposal.typ -f typst -t markdown --wrap=none \
		-M keep-centred-notes=true \
		--lua-filter=scripts/resolve-crossrefs.lua \
		--citeproc --bibliography=citations.bib --csl=scripts/ieee.csl \
		-o $@
	$(PY) scripts/clean-markdown.py $@

# HTML output is self-contained in its own dir: copy in the referenced SVGs and
# the stylesheet so the page renders standalone (clean-html.py rewrites figure
# paths to bare graphs/… and diagrams/… relative to the HTML).
$(P2_OUT)/proposal.html: $(P2_DIR)/proposal.typ citations.bib $(GRAPHS_TXT) $(GRAPHS_SVG) $(DIAGRAMS_SVG) $(DIST)/evaluation.json $(UI_FIGS) scripts/resolve-crossrefs.lua scripts/ieee.csl scripts/proposal.css scripts/clean-html.py | $(P2_OUT)
	pandoc $(P2_DIR)/proposal.typ -f typst -t html --standalone --wrap=none \
		-M keep-centred-notes=true \
		--lua-filter=scripts/resolve-crossrefs.lua \
		--citeproc --bibliography=citations.bib --csl=scripts/ieee.csl \
		--css=proposal.css \
		-o $@
	$(PY) scripts/clean-html.py $@
	cp scripts/proposal.css $(P2_OUT)/
	@mkdir -p $(P2_OUT)/graphs $(P2_OUT)/diagrams $(P2_OUT)/ui
	cp $(GRAPHS_SVG) $(P2_OUT)/graphs/
	cp $(DIAGRAMS_SVG) $(P2_OUT)/diagrams/
	cp $(UI_FIGS) $(P2_OUT)/ui/

# ── Deprecated aliases → Paper 2 (transition only) ──────────────────
$(DIST)/proposal.pdf: $(P2_OUT)/proposal.pdf | $(DIST)
	cp $< $@

$(DIST)/proposal.md: $(P2_OUT)/proposal.md | $(DIST)
	cp $< $@

# The alias HTML lives directly in dist/, where its bare graphs/… and diagrams/…
# figure references resolve against the shared dist/graphs and dist/diagrams.
$(DIST)/proposal.html: $(P2_OUT)/proposal.html scripts/proposal.css | $(DIST)
	cp $(P2_OUT)/proposal.html $@
	cp scripts/proposal.css $(DIST)/

# ── Graph inspector (opt-in; never part of `make build`) ────────────
# The UI's toolchain (Node) is isolated in ui/ with its own lockfile; the
# corpus build must succeed on a machine with no Node at all (the committed
# ui/screenshots/*.png serve the paper figures, regenerated by `make ui-e2e`).

# The Python execution API on its own (http://127.0.0.1:8123).
api:
	$(PY_POC) -m poc.inspector_api

# API + Next.js dev server together; Ctrl-C stops both.
ui:
	cd ui && npm install
	@trap 'kill 0' EXIT INT TERM; \
	$(PY_POC) -m poc.inspector_api & \
	cd ui && npm run dev

# Typecheck + production build of the UI.
ui-check:
	cd ui && npm install && npm run typecheck && npm run build

# End-to-end checks of the paper-facing claims; regenerates ui/screenshots/.
ui-e2e:
	cd ui && npm install && npm run e2e

# ── WASM sandbox tier (unchanged) ───────────────────────────────────
RUST_DIR    := $(ROOT)/poc/sandbox/rust
WASM_OUT    := $(ROOT)/poc/sandbox/wasm
# NOT wasm32-wasip1/wasip2: those link std against WASI, so the artifact would
# import fd_write/environ_get (wasip1) or wasi:cli/* (wasip2) even when it never
# uses them. Building for unknown-unknown and converting to a component with no
# WASI adapter leaves an import set containing only the node's capability
# interfaces — which is the property the component tier exists to demonstrate.
WASM_TARGET := wasm32-unknown-unknown
WASM_MODULES := node_parse_message node_moderate_content node_fetch_context \
                node_generate_response node_send_reply node_heartbeat \
                hostile_ambient hostile_ungranted hostile_clocked \
                node_start_run node_load_subscriptions node_fetch_feeds \
                node_drop_seen node_classify_item node_summarise_item \
                node_compose_digest node_publish_digest node_record_seen \
                hostile_exfiltrating_classifier hostile_seen_writer

# Build the component-tier WASM node artifacts and copy them into
# poc/sandbox/wasm/ (which is committed).
#
# Two steps, and the second is the interesting one:
#   1. cargo builds each node crate to a *core* module. wit_bindgen::generate!
#      reads poc/sandbox/wit/caps.wit and emits the typed bindings, plus a
#      `component-type` custom section describing the crate's world.
#   2. `wasm-tools component new` reads that section and wraps the core module
#      into a *component* whose imports and exports are the WIT interfaces. No
#      `--adapt` flag is passed: no WASI adapter is linked, so the component
#      imports nothing but its declared capability interfaces.
#
# Requires a Rust toolchain with the wasm32-unknown-unknown target
# (`rustup target add wasm32-unknown-unknown`) and wasm-tools
# (`brew install wasm-tools` / `cargo install wasm-tools`). This is NOT part of
# `make build` or the pre-commit hooks — the committed artifacts let the sandbox
# tests run without either toolchain. Rebuild only when the Rust sources or the
# WIT change.
#
# This rebuilds *every* artifact, and a rebuilt component whose source did not
# change can still differ in bytes (a newer toolchain, a grown WIT package).
# Commit only the artifacts whose crates you changed, and `git checkout` the
# rest: the nine components Paper 2 reports on are its evidence as built, and
# should not churn because a feed-triage node was edited.
wasm:
	cargo build --manifest-path $(RUST_DIR)/Cargo.toml --release --target $(WASM_TARGET)
	@mkdir -p $(WASM_OUT)
	@for m in $(WASM_MODULES); do \
		wasm-tools component new \
			$(RUST_DIR)/target/$(WASM_TARGET)/release/$$m.wasm \
			-o $(WASM_OUT)/$$m.wasm ; \
		echo "  wrote poc/sandbox/wasm/$$m.wasm (component)" ; \
	done

# ── Output directories ──────────────────────────────────────────────
$(DIST) $(DIST)/graphs $(DIST)/diagrams $(DIST)/ui $(P1_OUT) $(P1_OUT)/graphs $(P1_OUT)/diagrams $(P2_OUT):
	mkdir -p $@

clean:
	rm -rf $(DIST)
