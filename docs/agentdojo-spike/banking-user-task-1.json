{
  "name": "BankingUserTask1",

  "parameters": [
    "TaskRequest",
    "DBHandle<'bank-account', read>",
    "ResponseChannel<user-session>"
  ],

  "capabilities": [
    "DBHandle<'bank-account', read>",
    "ResponseChannel<user-session>"
  ],

  "nodes": [
    {
      "name": "ReadTransactions",
      "inputs": ["TaskRequest", "DBHandle<'bank-account', read>"],
      "output": "Untrusted<TransactionList>"
    },
    {
      "name": "SumMarchSpending",
      "inputs": ["Untrusted<TransactionList>"],
      "output": "SpendingTotal",
      "discharges_trust": true,
      "ensures": ["total >= 0"]
    },
    {
      "name": "Answer",
      "inputs": ["SpendingTotal", "ResponseChannel<user-session>"],
      "output": "DeliveryConfirmation"
    }
  ],

  "data_edges": [
    { "from": "ReadTransactions", "to": "SumMarchSpending" },
    { "from": "SumMarchSpending", "to": "Answer" }
  ]
}
