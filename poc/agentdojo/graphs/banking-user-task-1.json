{
  "name": "BankingUserTask1",
  "parameters": [
    "TaskRequest",
    "DBHandle<'transactions', read>",
    "ResponseChannel<user-session>"
  ],
  "capabilities": [
    "DBHandle<'transactions', read>",
    "ResponseChannel<user-session>"
  ],
  "nodes": [
    { "name": "Start", "uses": "Start", "inputs": ["TaskRequest"], "output": "TaskRequest" },
    {
      "name": "ReadTransactions",
      "uses": "ReadTransactions",
      "inputs": ["TaskRequest", "DBHandle<'transactions', read>"],
      "output": "Untrusted<TransactionList>"
    },
    {
      "name": "SumMarchSpending",
      "uses": "SumAmounts",
      "params": { "where": ["sender == 'me'", "date >= '2022-03-01'", "date < '2022-04-01'"] },
      "inputs": ["Untrusted<TransactionList>"],
      "output": "Untrusted<Total>"
    },
    {
      "name": "Answer",
      "uses": "Respond",
      "params": { "template": "Your total spending in March 2022 was {in0.amount}." },
      "inputs": ["Untrusted<Total>", "ResponseChannel<user-session>"],
      "output": "DeliveryConfirmation",
      "discharges_trust": true
    }
  ],
  "data_edges": [
    { "from": "Start", "to": "ReadTransactions" },
    { "from": "ReadTransactions", "to": "SumMarchSpending" },
    { "from": "SumMarchSpending", "to": "Answer" }
  ]
}
