{
  "customer-support": {
    "ParseMessage": {
      "requires": [
        "len(value.text) <= 4000"
      ],
      "ensures": [
        "intent in ['billing_question', 'technical_support', 'account_change', 'general_inquiry', 'unknown']",
        "len(question) <= 512"
      ]
    },
    "ModerateContent": {
      "requires": [
        "len(question) <= 512"
      ]
    },
    "FetchContext": {
      "requires": [
        "len(query.question) <= 512"
      ],
      "ensures": [
        "len(question) <= 512",
        "present(knowledge)"
      ]
    },
    "GenerateResponse": {
      "requires": [
        "len(question) <= 512"
      ]
    },
    "SendReply": {
      "requires": [
        "len(text) <= 100000"
      ],
      "ensures": [
        "delivered == true",
        "present(session_id)"
      ]
    }
  },
  "feed-pulse": {
    "Heartbeat": {
      "ensures": [
        "notified == true"
      ]
    }
  }
}
