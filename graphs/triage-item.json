{
  "name": "TriageItem",
  "parameters": [
    "Untrusted<FeedItem>",
    "LLMClient<inference>"
  ],
  "capabilities": [
    "LLMClient<inference>"
  ],
  "nodes": [
    {
      "name": "ClassifyItem",
      "inputs": [
        "Untrusted<FeedItem>",
        "LLMClient<inference>"
      ],
      "output": "keep: ClassifiedItem | drop: DroppedItem",
      "discharges_trust": true
    },
    {
      "name": "SummariseItem",
      "inputs": [
        "ClassifiedItem",
        "LLMClient<inference>"
      ],
      "output": "ItemVerdict",
      "ensures": [
        "kept == true",
        "len(summary) <= 400"
      ]
    },
    {
      "name": "SkipItem",
      "inputs": [
        "DroppedItem"
      ],
      "output": "ItemVerdict",
      "ensures": [
        "kept == false",
        "len(summary) == 0"
      ]
    }
  ],
  "data_edges": [
    {
      "from": "ClassifyItem.keep",
      "to": "SummariseItem"
    },
    {
      "from": "ClassifyItem.drop",
      "to": "SkipItem"
    }
  ],
  "layout": {
    "zones": {
      "untrusted": {
        "label": "UNTRUSTED",
        "color": "#b33",
        "background": "#fef0f0",
        "nodes": [
          "ClassifyItem"
        ]
      },
      "structured": {
        "label": "STRUCTURED",
        "color": "#272",
        "background": "#f0f7f0",
        "nodes": [
          "SummariseItem",
          "SkipItem"
        ]
      }
    },
    "positions": {
      "ClassifyItem": [
        0,
        0
      ],
      "SummariseItem": [
        -0.7,
        1.2
      ],
      "SkipItem": [
        0.7,
        1.2
      ]
    },
    "edge_colors": {
      "keep": "#272",
      "drop": "#888"
    },
    "untrusted_label_color": "#b33"
  }
}
