{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codeliance/architecture-as-program/graphs/schema.json",
  "title": "Signal graph definition",
  "description": "A canonical signal graph. Single source of truth for generated pseudocode and diagrams.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "parameters", "capabilities", "nodes", "data_edges"],
  "properties": {
    "name": {
      "description": "PascalCase graph identifier. Also the node name when the graph is used as a sub-graph in another definition.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "parameters": {
      "description": "Ordered list of external type signatures the graph accepts, including both data inputs and capability handles.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "capabilities": {
      "description": "Subset of `parameters` that are capability handles (as opposed to data inputs). Each entry must appear verbatim in `parameters`.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "inputs", "output"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "inputs": {
            "description": "Typed inputs to the node. Entries that match strings in the enclosing graph's `capabilities` are treated as capability handles; the rest are data inputs.",
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "output": {
            "description": "Single output type, or a sum type expressed as `role1: Type1 | role2: Type2 | ...` with edge-addressable role labels.",
            "type": "string",
            "minLength": 1
          },
          "discharges_trust": {
            "description": "Set to true on nodes that consume an `Untrusted<_>` input and emit a non-`Untrusted` output. The validator requires this marker so trust discharge is explicit at the graph level.",
            "type": "boolean"
          }
        }
      }
    },
    "data_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {
            "description": "Source node name, optionally with a `.role` suffix to address a specific variant of a sum-typed output.",
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9_-]*)?$"
          },
          "to": {
            "description": "Target node name.",
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "label_side": {
            "type": "string",
            "enum": ["left", "right", "top", "bottom"]
          }
        }
      }
    },
    "layout": {
      "description": "Optional rendering hints consumed by scripts/generate-graph.py. No semantic effect.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zones": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["label", "color", "background", "nodes"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
              "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
              "nodes": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "positions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          }
        },
        "edge_colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{3,8}$"
          }
        },
        "untrusted_label_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{3,8}$"
        }
      }
    }
  }
}
