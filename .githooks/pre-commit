#!/bin/sh
# Pre-commit hook: test, validate graphs, build outputs, check citations.
# Runs under the uv-managed project environment.

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Run pytest (type parser + graph validator tests). Fast; stdlib-only
# runtime, pytest as dev dep managed by uv.
uv run pytest

# Validate canonical graph JSONs (structural + type-aware + cross-graph).
uv run python3 scripts/validate-graphs.py

make build

# Check for unused bib entries (warnings only, non-blocking)
uv run python3 scripts/check-citations.py

echo "Pre-commit checks passed."
