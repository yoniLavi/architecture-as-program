#!/bin/sh
# Pre-commit hook: test, validate graphs, build outputs, check citations

set -e

ROOT="$(git rev-parse --show-toplevel)"

# Run unit tests for the type parser + graph validator. Fast; stdlib-only.
python3 -m unittest discover -s "$ROOT/tests" -t "$ROOT"

# Validate canonical graph JSONs (structural + type-aware + cross-graph).
python3 "$ROOT/scripts/validate-graphs.py"

make build

# Check for unused bib entries (warnings only, non-blocking)
python3 "$ROOT/scripts/check-citations.py"

echo "Pre-commit checks passed."
