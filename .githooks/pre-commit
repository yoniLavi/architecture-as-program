#!/bin/sh
# Pre-commit hook: validate graphs, build outputs, check citations

set -e

ROOT="$(git rev-parse --show-toplevel)"

# Validate canonical graph JSONs (structural + cross-file consistency).
# Blocks the commit if graphs are malformed; caught before the build
# so failures surface with schema-specific error messages.
python3 "$ROOT/scripts/validate-graphs.py"

make build

# Check for unused bib entries (warnings only, non-blocking)
python3 "$ROOT/scripts/check-citations.py"

echo "Pre-commit checks passed."
